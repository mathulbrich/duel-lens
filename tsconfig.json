{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["chrome", "node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src", "tools", "test", "vitest.config.ts"],
  // Local diagnosis scripts (gitignored, like /tools/diag-*/ in .gitignore) must not break the type check.
  // The E2E harness and the scripts that drive a browser load Puppeteer from test/e2e/'s own install
  // (`npm install` there): tsconfig.e2e.json checks them, so a fresh clone with only `npm ci` passes this one.
  "exclude": [
    "tools/diag-*",
    "test/e2e",
    "tools/live-check",
    "tools/partial",
    "tools/readme-media",
    "tools/store-shots",
    "tools/train/foil-capture.ts",
    "tools/realset2/capture.ts",
    "tools/realset2/context.ts",
    "tools/overnight/harvest.ts"
  ]
}
