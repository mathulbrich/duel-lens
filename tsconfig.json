{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["chrome", "node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src", "tools", "test", "vitest.config.ts"],
  // Local diagnosis scripts (gitignored, like /tools/diag-*/ in .gitignore) must not break the type check.
  "exclude": ["tools/diag-*"]
}
